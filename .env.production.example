# BilgeAPI v1.2.0 - Production Environment Variables Example Template
# Do not place real secrets in this template. Use it for verify_production_env_safety audits.

APP_ENV=production
ENVIRONMENT=production
RUNTIME_PROFILE=production
LOG_LEVEL=INFO
DEBUG=false

# Database
# Note: Host must not be localhost or 127.0.0.1 in production.
DATABASE_URL=postgresql+asyncpg://postgres:prod_db_password_hash_placeholder@db.production.local:5432/ai_company
BILGEAPI_DATABASE_URL=postgresql+asyncpg://postgres:prod_db_password_hash_placeholder@db.production.local:5432/ai_company

# Encryption Keys (Must be 64 characters hex for JWT, >= 16 characters for webhook)
JWT_SECRET=d3c10a48a9ca2fa102b4d5885c3453b3f2c5f1cd3e6d89db7a6bca23fcf12e4f
ADMIN_SECRET=a3c10a48a9ca2fa102b4d5885c3453b3f2c5f1cd3e6d89db7a6bca23fcf12e4f
BILGEAPI_JWT_SECRET=f3c10a48a9ca2fa102b4d5885c3453b3f2c5f1cd3e6d89db7a6bca23fcf12e4f
BILGEAPI_WEBHOOK_SECRET=secure_webhook_secret_length_32chars_long

# Authentication Mode
BILGEAPI_AUTH_MODE=api_key

# Static Keys
# BILGEAPI_STATIC_KEYS must be empty in production.
BILGEAPI_STATIC_KEYS=
# BILGEAPI_STATIC_KEY_HASHES contains sha256_hash:role mappings.
BILGEAPI_STATIC_KEY_HASHES=d3c10a48a9ca2fa102b4d5885c3453b3f2c5f1cd3e6d89db7a6bca23fcf12e4f:admin,a3c10a48a9ca2fa102b4d5885c3453b3f2c5f1cd3e6d89db7a6bca23fcf12e4f:operator

# Hardening
BILGEAPI_ALLOW_PRIVATE_WEBHOOKS=false
BILGEAPI_RATE_LIMIT_RPS=10

# Security Defaults
BILGEAPI_SELF_HEALING_ENABLED=false
BILGEAPI_EXTERNAL_AGENTS_ENABLED=false
