# ─── BilgeAPI Dockerfile ──────────────────────────────────
# Lightweight image — no Playwright/browser dependencies.
# Port: 8100 (default)

# ─── Stage 1: Builder ────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

# Build dependencies for psycopg/asyncpg
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends --fix-missing \
       gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ─── Stage 2: Runtime ────────────────────────────────────
FROM python:3.12-slim-bookworm AS runtime

# Security: non-root user
RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid appgroup --no-create-home appuser

WORKDIR /app

# Minimal runtime dependencies (PostgreSQL client + curl for healthcheck)
RUN apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends --fix-missing \
       libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY . .

# Cleanup: remove secrets, tests, heavy files not needed at runtime
RUN rm -rf .env .env.local *.pyc __pycache__ tests/ node_modules/ \
           .git/ .playwright-browsers/ .pytest_cache/ .mypy_cache/ \
           .ruff_cache/ cortex_local_v2.db governance_test.db \
           playwright_*.log *.zip *.tar *.gz

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${BILGEAPI_PORT:-8100}/health || exit 1

# Startup: run migrations then launch gunicorn
# NOTE: Single-instance deployment uses startup migration.
#       Multi-replica production should run migration as a separate one-off job.
CMD ["sh", "-c", \
    "python -m apps.bilgeapi.startup && \
     alembic -c alembic.ini upgrade head && \
     gunicorn apps.bilgeapi.main:app \
        --worker-class uvicorn.workers.UvicornWorker \
        --workers ${BILGEAPI_WORKERS:-2} \
        --bind 0.0.0.0:${BILGEAPI_PORT:-8100} \
        --timeout 120 \
        --access-logfile -"]
