FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Build phase
FROM base AS builder

# Focus only on the CMS subdirectory
COPY hub_interaction/cms/package.json hub_interaction/cms/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY hub_interaction/cms/ ./
RUN pnpm build

# Production phase
FROM base AS runner

WORKDIR /app

COPY --from=builder /app/next.config.mjs ./
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
# Inclusion of essential Payload/Next.js files
COPY --from=builder /app/payload.config.ts ./
COPY --from=builder /app/tsconfig.json ./
COPY --from=builder /app/src ./src

EXPOSE 3100

ENV PORT 3100
ENV NODE_ENV production

CMD ["pnpm", "start"]
