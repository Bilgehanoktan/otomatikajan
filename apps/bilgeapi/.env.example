# BilgeAPI Environment Template
# Copy this file to `.env` and fill in the real values.
# Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Port on which the FastAPI application will run
BILGEAPI_PORT=8100

# Authentication mode: 'disabled' (only for test env), 'api_key', or 'jwt'
BILGEAPI_AUTH_MODE=api_key

# Comma-separated list of static API keys for access (format: key1:role,key2:role or just key1)
# Supported roles: SOVEREIGN_PRIME, ADMIN, OPERATOR, AUDIT_OBSERVER
BILGEAPI_STATIC_KEYS=your_static_api_key_here:OPERATOR

# Database Connection
# SQLite fallback is used automatically in development if PostgreSQL is unreachable or not set.
BILGEAPI_DATABASE_URL=sqlite+aiosqlite:///bilgeapi.db
# For PostgreSQL:
# BILGEAPI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bilgeapi

# JWT Secret for authentication (only required if BILGEAPI_AUTH_MODE is 'jwt')
BILGEAPI_JWT_SECRET=your_jwt_secret_64_characters_or_more_here

# Webhook signature secret used for HMAC-SHA256 headers (mandatory in production)
BILGEAPI_WEBHOOK_SECRET=your_webhook_secret_here

# Allowed origins for CORS (comma-separated list)
BILGEAPI_CORS_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000

# Rate limits (Requests Per Second)
BILGEAPI_RATE_LIMIT_RPS=10

# Durable Queue Settings (Requires Redis & Celery)
BILGEAPI_DURABLE_QUEUE_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

# LLM Providers (for AI Improvement & Patch Suggestion services)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
