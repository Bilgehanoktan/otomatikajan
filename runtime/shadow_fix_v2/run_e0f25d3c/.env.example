# AI Company - environment template
# Copy this file to `.env` and fill in the real values.
# Never commit real secrets.

APP_ENV=development
ENVIRONMENT=development
RUNTIME_PROFILE=local-dev
LOG_LEVEL=INFO
DEBUG=false

# Runtime profiles
# - local-dev: minimal local topology, in-process queue, Redis/DeerFlow off
# - full-stack-local: local Docker stack with Redis + Celery + DeerFlow
# - production: static UI + primary DB + Redis/Celery scheduler
QUEUE_BACKEND=inprocess
APP_UI_MODE=api-only
LOCAL_DEV_DB_STRATEGY=sqlite-fallback
REDIS_ENABLED=false
CELERY_ENABLED=false
DEERFLOW_ENABLED=false
TELEGRAM_ENABLED=false
SCHEDULER_ENABLED=false

# LLM providers (at least one is required)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MOONSHOT_API_KEY=your_moonshot_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
FALLBACK_API_KEY=your_fallback_key_here

# Services
SERPER_API_KEY=your_serper_key_here
GITHUB_TOKEN=your_github_token_here
CLAUDE_PROXY_URL=http://host.docker.internal:51200
DISCORD_WEBHOOK_URL=
FRONTEND_URL=http://app:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/ai_company
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
MEMORY_DATABASE_URL=sqlite:///memory.db
MEMORY_MODE=inject

# Redis / Celery
# Enable these in full-stack-local or production profiles.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Security (production: use 64+ char secrets)
ADMIN_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_64

# Telegram (optional)
# Keep TELEGRAM_ENABLED=false unless the bot is intentionally enabled.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_IDS=12345678,87654321
TELEGRAM_ADMIN_IDS=12345678
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# DeerFlow integration
# Keep DEERFLOW_ENABLED=false for the minimal local-dev profile.
DEERFLOW_BRIDGE_URL=http://deerflow-bridge:8010
DEERFLOW_CONFIG_PATH=/opt/deerflow/config.yaml
