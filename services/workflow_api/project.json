{
  "name": "workflow-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/workflow_api",
  "tags": ["type:service", "platform:python", "scope:execution"],
  "implicitDependencies": ["lib-workflow", "lib-db", "lib-auth"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m uvicorn services.workflow_api.main:app --host 0.0.0.0 --port 8000 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m pytest tests/test_phase13_workflow.py tests/integration/test_mesh_api.py -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m ruff check services/workflow_api"
      }
    }
  }
}
